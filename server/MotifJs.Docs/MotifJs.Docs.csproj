<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- The synced docs database ships with the site; `npm run release` builds both first. -->
  <ItemGroup>
    <None Include="App_Data\docs.db" CopyToPublishDirectory="PreserveNewest" Condition="Exists('App_Data\docs.db')" />
  </ItemGroup>

</Project>
